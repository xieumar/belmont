# Server-only. Never prefix these with NEXT_PUBLIC_.
# Copy to .env.local and fill in. See README for where to find each value.

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes; literal \n sequences are converted to newlines.
FIREBASE_PRIVATE_KEY=""

# Local development against the emulator (no credentials needed):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
